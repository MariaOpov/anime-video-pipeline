{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "phase", "status", "project_name", "created_at", "pipeline_version", "tool_versions", "run", "summary", "quality_gates", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "phase": {"const": 5},
    "status": {"enum": ["complete", "failed"]},
    "project_name": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "pipeline_version": {"type": "string", "minLength": 1},
    "tool_versions": {
      "type": "object",
      "required": ["python", "pipeline", "blender", "piper_tts", "rhubarb", "ffmpeg"],
      "additionalProperties": {"type": ["string", "null"]}
    },
    "run": {"type": "object"},
    "summary": {
      "type": "object",
      "required": ["quality_gate_count", "passed_gate_count", "failed_gate_count", "scene_count", "shot_count", "unresolved_motion_count", "dialogue_count", "mouth_cue_count", "timing_warning_count", "performance_clip_count", "gesture_count", "pose_keyframe_count", "skipped_bone_alias_count", "dialogue_beat_count", "gaze_target_count", "gaze_keyframe_count", "blink_event_count", "blink_keyframe_count", "listener_reaction_count", "performance_conflict_count", "blocking_shot_count", "character_placement_count", "body_facing_count", "placement_keyframe_count", "camera_motion_count", "camera_keyframe_count", "framing_risk_count", "camera_collision_risk_count", "continuity_violation_count", "blocking_conflict_count", "duration_seconds", "output_size_bytes", "output_width", "output_height", "estimated_cost"],
      "properties": {
        "quality_gate_count": {"type": "integer", "minimum": 1},
        "passed_gate_count": {"type": "integer", "minimum": 0},
        "failed_gate_count": {"type": "integer", "minimum": 0},
        "scene_count": {"type": "integer", "minimum": 0},
        "shot_count": {"type": "integer", "minimum": 0},
        "unresolved_motion_count": {"type": "integer", "minimum": 0},
        "dialogue_count": {"type": "integer", "minimum": 0},
        "mouth_cue_count": {"type": "integer", "minimum": 0},
        "timing_warning_count": {"type": "integer", "minimum": 0},
        "performance_clip_count": {"type": "integer", "minimum": 0},
        "gesture_count": {"type": "integer", "minimum": 0},
        "pose_keyframe_count": {"type": "integer", "minimum": 0},
        "skipped_bone_alias_count": {"type": "integer", "minimum": 0},
        "dialogue_beat_count": {"type": "integer", "minimum": 0},
        "gaze_target_count": {"type": "integer", "minimum": 0},
        "gaze_keyframe_count": {"type": "integer", "minimum": 0},
        "blink_event_count": {"type": "integer", "minimum": 0},
        "blink_keyframe_count": {"type": "integer", "minimum": 0},
        "listener_reaction_count": {"type": "integer", "minimum": 0},
        "performance_conflict_count": {"type": "integer", "minimum": 0},
        "blocking_shot_count": {"type": "integer", "minimum": 0},
        "character_placement_count": {"type": "integer", "minimum": 0},
        "body_facing_count": {"type": "integer", "minimum": 0},
        "placement_keyframe_count": {"type": "integer", "minimum": 0},
        "camera_motion_count": {"type": "integer", "minimum": 0},
        "camera_keyframe_count": {"type": "integer", "minimum": 0},
        "framing_risk_count": {"type": "integer", "minimum": 0},
        "camera_collision_risk_count": {"type": "integer", "minimum": 0},
        "continuity_violation_count": {"type": "integer", "minimum": 0},
        "blocking_conflict_count": {"type": "integer", "minimum": 0},
        "duration_seconds": {"type": "number", "minimum": 0},
        "output_size_bytes": {"type": "integer", "minimum": 0},
        "output_width": {"type": "integer", "minimum": 0},
        "output_height": {"type": "integer", "minimum": 0},
        "estimated_cost": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "quality_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["phase", "name", "status", "expected", "actual"],
        "properties": {
          "phase": {"type": "integer", "minimum": 1, "maximum": 4},
          "name": {"type": "string", "minLength": 1},
          "status": {"enum": ["passed", "failed"]},
          "expected": {},
          "actual": {},
          "detail": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path", "size_bytes"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "size_bytes": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
