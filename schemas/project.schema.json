{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["project_name", "output", "language", "maximum_video_duration", "maximum_allowed_cost"],
  "properties": {
    "project_name": {"type": "string", "minLength": 1},
    "script": {"type": "string", "default": "script.txt"},
    "preset": {"enum": ["preview", "balanced", "final"]},
    "language": {"type": "string", "minLength": 2},
    "subtitle_language": {"type": "string"},
    "render_engine": {"enum": ["BLENDER_EEVEE", "BLENDER_EEVEE_NEXT", "BLENDER_WORKBENCH"]},
    "render_device": {"enum": ["CPU", "GPU", "AUTO"]},
    "output": {
      "type": "object",
      "required": ["width", "height", "fps"],
      "properties": {
        "width": {"type": "integer", "minimum": 320},
        "height": {"type": "integer", "minimum": 240},
        "fps": {"type": "integer", "minimum": 12, "maximum": 120}
      },
      "additionalProperties": false
    },
    "maximum_video_duration": {"type": "integer", "minimum": 1, "maximum": 86400},
    "maximum_allowed_cost": {"type": "number", "minimum": 0, "maximum": 10},
    "asset_library_paths": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "characters": {"type": "object", "additionalProperties": {"type": "object"}},
    "screenplay": {
      "type": "object",
      "properties": {
        "analyzer": {"enum": ["auto", "ollama", "rules"]},
        "ollama_endpoint": {"type": "string"},
        "ollama_model": {"type": "string"}
      },
      "additionalProperties": true
    },
    "phase2": {
      "type": "object",
      "required": ["enabled", "piper_data_dir", "rhubarb_executable", "voices"],
      "properties": {
        "enabled": {"type": "boolean"},
        "piper_data_dir": {"type": "string"},
        "rhubarb_executable": {"type": "string"},
        "rhubarb_recognizer": {"enum": ["pocketSphinx", "phonetic"]},
        "default_voice": {"type": "string"},
        "silence_before_seconds": {"type": "number", "minimum": 0, "maximum": 5},
        "silence_after_seconds": {"type": "number", "minimum": 0, "maximum": 5},
        "dialogue_gap_seconds": {"type": "number", "minimum": 0, "maximum": 5},
        "normalization_peak": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "voices": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object", "required": ["model"],
            "properties": {
              "model": {"type": "string", "minLength": 1},
              "data_dir": {"type": "string"},
              "speaker": {"type": "integer", "minimum": 0},
              "length_scale": {"type": "number", "exclusiveMinimum": 0},
              "noise_scale": {"type": "number", "minimum": 0},
              "noise_w_scale": {"type": "number", "minimum": 0},
              "volume": {"type": "number", "minimum": 0}
            },
            "additionalProperties": false
          }
        },
        "mouth_morph_mapping": {
          "type": "object",
          "propertyNames": {"pattern": "^[A-HX]$"},
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "phase3": {
      "type": "object",
      "required": ["enabled", "base_scene", "output_scene", "preview_video"],
      "properties": {
        "enabled": {"type": "boolean"},
        "base_scene": {"type": "string", "minLength": 1},
        "output_scene": {"type": "string", "minLength": 1},
        "preview_video": {"type": "string", "minLength": 1},
        "resolution_percentage": {"type": "integer", "minimum": 1, "maximum": 100},
        "camera": {
          "type": "object",
          "properties": {
            "close_up_distance": {"type": "number", "exclusiveMinimum": 0},
            "medium_distance": {"type": "number", "exclusiveMinimum": 0},
            "wide_distance": {"type": "number", "exclusiveMinimum": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "phase4": {
      "type": "object",
      "required": ["enabled", "input_video", "subtitle_file", "output_video"],
      "properties": {
        "enabled": {"type": "boolean"},
        "input_video": {"type": "string", "minLength": 1},
        "subtitle_file": {"type": "string", "minLength": 1},
        "output_video": {"type": "string", "minLength": 1},
        "subtitle_mode": {"enum": ["auto", "burn", "soft"]},
        "include_speaker_names": {"type": "boolean"},
        "subtitle_language_code": {"type": "string", "minLength": 3, "maxLength": 3},
        "subtitle_style": {"type": "string", "minLength": 1},
        "video_codec": {"type": "string", "minLength": 1},
        "video_preset": {"enum": ["ultrafast", "superfast", "veryfast", "faster", "fast", "medium", "slow", "slower", "veryslow"]},
        "crf": {"type": "integer", "minimum": 0, "maximum": 51},
        "audio_codec": {"type": "string", "minLength": 1},
        "audio_bitrate": {"type": "string", "pattern": "^[0-9]+[kKmM]$"},
        "loudness_target_lufs": {"type": "number", "minimum": -70, "maximum": -5},
        "true_peak_db": {"type": "number", "minimum": -9, "maximum": 0},
        "loudness_range_lu": {"type": "number", "minimum": 1, "maximum": 50}
      },
      "additionalProperties": false
    },
    "phase5": {
      "type": "object",
      "required": ["enabled", "report"],
      "properties": {
        "enabled": {"type": "boolean"},
        "report": {"type": "string", "minLength": 1},
        "max_asset_warnings": {"type": "integer", "minimum": 0},
        "max_unresolved_motion_assignments": {"type": "integer", "minimum": 0},
        "max_timing_warnings": {"type": "integer", "minimum": 0},
        "min_output_size_bytes": {"type": "integer", "minimum": 1},
        "duration_tolerance_seconds": {"type": "number", "minimum": 0, "maximum": 10}
      },
      "additionalProperties": false
    },
    "motion_fallbacks": {
      "type": "object",
      "additionalProperties": {"type": "array", "items": {"type": "string"}}
    }
  },
  "additionalProperties": true
}
