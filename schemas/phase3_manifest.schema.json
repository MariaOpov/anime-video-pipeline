{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "project_name", "fps", "frame_start", "frame_end", "base_scene", "output_scene", "preview_video", "render", "camera", "performance", "blocking", "character_assets", "shots", "dialogue", "summary"],
  "properties": {
    "version": {"const": 5},
    "project_name": {"type": "string", "minLength": 1},
    "fps": {"type": "integer", "minimum": 1},
    "frame_start": {"type": "integer", "minimum": 1},
    "frame_end": {"type": "integer", "minimum": 1},
    "base_scene": {"type": "string", "minLength": 1},
    "output_scene": {"type": "string", "minLength": 1},
    "preview_video": {"type": "string", "minLength": 1},
    "render": {
      "type": "object", "required": ["engine", "width", "height", "resolution_percentage"],
      "properties": {
        "engine": {"type": "string"}, "width": {"type": "integer", "minimum": 320},
        "height": {"type": "integer", "minimum": 240},
        "resolution_percentage": {"type": "integer", "minimum": 1, "maximum": 100}
      }, "additionalProperties": false
    },
    "camera": {"type": "object"},
    "performance": {
      "type": "object",
      "required": ["enabled", "source", "amplitude_scale", "clips", "gaze_events", "blink_events", "dialogue_beat_count", "listener_reaction_count", "performance_conflict_count"],
      "properties": {
        "enabled": {"type": "boolean"},
        "source": {"enum": [null, "rules", "ollama", "manual"]},
        "amplitude_scale": {"type": "number", "minimum": 0.1, "maximum": 3.0},
        "clips": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["scene_id", "shot_id", "character", "role", "start_frame", "end_frame", "action", "emotion", "intensity", "gestures", "look_at", "beats"],
            "properties": {
              "scene_id": {"type": "string", "minLength": 1},
              "shot_id": {"type": "string", "minLength": 1},
              "character": {"type": "string", "minLength": 1},
              "role": {"enum": ["speaker", "listener", "performer"]},
              "start_frame": {"type": "integer", "minimum": 1},
              "end_frame": {"type": "integer", "minimum": 1},
              "action": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
              "emotion": {"enum": ["neutral", "sad", "angry", "surprised", "happy", "fearful", "determined"]},
              "intensity": {"type": "number", "minimum": 0, "maximum": 1},
              "gestures": {
                "type": "array", "maxItems": 4, "uniqueItems": true,
                "items": {"enum": ["look_down", "look_up", "head_tilt", "nod", "shake_head", "small_hand_motion", "open_hand", "point", "step_forward", "step_back", "turn_left", "turn_right", "breathe", "wind_sway"]}
              },
              "look_at": {"type": ["string", "null"]},
              "beats": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["type", "gesture", "start_frame", "peak_frame", "end_frame"],
                  "properties": {
                    "type": {"enum": ["speech", "gesture", "listener_reaction"]},
                    "gesture": {"enum": [null, "look_down", "look_up", "head_tilt", "nod", "shake_head", "small_hand_motion", "open_hand", "point", "step_forward", "step_back", "turn_left", "turn_right", "breathe", "wind_sway"]},
                    "start_frame": {"type": "integer", "minimum": 1},
                    "peak_frame": {"type": "integer", "minimum": 1},
                    "end_frame": {"type": "integer", "minimum": 1}
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "gaze_events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["scene_id", "shot_id", "character", "target", "start_frame", "end_frame"],
            "properties": {
              "scene_id": {"type": "string"}, "shot_id": {"type": "string"},
              "character": {"type": "string"}, "target": {"type": "string"},
              "start_frame": {"type": "integer", "minimum": 1},
              "end_frame": {"type": "integer", "minimum": 1}
            },
            "additionalProperties": false
          }
        },
        "blink_events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["character", "close_frame", "open_frame"],
            "properties": {
              "character": {"type": "string"},
              "close_frame": {"type": "integer", "minimum": 1},
              "open_frame": {"type": "integer", "minimum": 1}
            },
            "additionalProperties": false
          }
        },
        "dialogue_beat_count": {"type": "integer", "minimum": 0},
        "listener_reaction_count": {"type": "integer", "minimum": 0},
        "performance_conflict_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "blocking": {
      "type": "object",
      "required": ["enabled", "shots", "placement_count", "body_facing_count", "camera_motion_count", "framing_risk_count", "camera_collision_risk_count", "continuity_violation_count", "blocking_conflict_count"],
      "properties": {
        "enabled": {"type": "boolean"},
        "shots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["scene_id", "shot_id", "start_frame", "end_frame", "composition", "subject", "listener", "placements", "camera", "framing_risk_count", "camera_collision_risk_count", "continuity_violation_count", "blocking_conflict_count"],
            "properties": {
              "scene_id": {"type": "string", "minLength": 1},
              "shot_id": {"type": "string", "minLength": 1},
              "start_frame": {"type": "integer", "minimum": 1},
              "end_frame": {"type": "integer", "minimum": 1},
              "composition": {"enum": ["single", "close_up", "over_shoulder", "two_shot"]},
              "subject": {"type": "string", "minLength": 1},
              "listener": {"type": ["string", "null"]},
              "placements": {
                "type": "array", "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["character", "position", "facing_target", "body_yaw_degrees"],
                  "properties": {
                    "character": {"type": "string", "minLength": 1},
                    "position": {
                      "type": "array", "minItems": 3, "maxItems": 3,
                      "items": {"type": "number", "minimum": -20, "maximum": 20}
                    },
                    "facing_target": {"type": ["string", "null"]},
                    "body_yaw_degrees": {"type": "number", "minimum": -35, "maximum": 35}
                  },
                  "additionalProperties": false
                }
              },
              "camera": {
                "type": "object",
                "required": ["movement", "lens_mm", "start_location", "end_location", "start_target", "end_target"],
                "properties": {
                  "movement": {"enum": ["static", "slow_dolly_in", "slow_dolly_out", "lateral_drift"]},
                  "lens_mm": {"type": "number", "minimum": 18, "maximum": 200},
                  "start_location": {"$ref": "#/$defs/vector3"},
                  "end_location": {"$ref": "#/$defs/vector3"},
                  "start_target": {"$ref": "#/$defs/vector3"},
                  "end_target": {"$ref": "#/$defs/vector3"}
                },
                "additionalProperties": false
              },
              "framing_risk_count": {"type": "integer", "minimum": 0},
              "camera_collision_risk_count": {"type": "integer", "minimum": 0},
              "continuity_violation_count": {"type": "integer", "minimum": 0},
              "blocking_conflict_count": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          }
        },
        "placement_count": {"type": "integer", "minimum": 0},
        "body_facing_count": {"type": "integer", "minimum": 0},
        "camera_motion_count": {"type": "integer", "minimum": 0},
        "framing_risk_count": {"type": "integer", "minimum": 0},
        "camera_collision_risk_count": {"type": "integer", "minimum": 0},
        "continuity_violation_count": {"type": "integer", "minimum": 0},
        "blocking_conflict_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "character_assets": {
      "type": "object",
      "required": ["enabled", "characters", "configured_count", "ready_count", "missing_texture_count", "warning_count", "license_warning_count"],
      "properties": {
        "enabled": {"type": "boolean"},
        "characters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["character", "profile", "cache_blend", "cache_collection", "armature_object", "model_sha256", "bone_mapping", "morph_mapping", "required_bone_count", "resolved_bone_count", "bone_coverage", "required_mouth_morph_count", "resolved_mouth_morph_count", "mouth_morph_coverage", "blink_morph_resolved", "texture_count", "missing_texture_count", "license_name", "license_warning", "warnings", "ready"],
            "properties": {
              "character": {"type": "string", "minLength": 1},
              "profile": {"type": "string", "minLength": 1},
              "cache_blend": {"type": "string", "minLength": 1},
              "cache_collection": {"type": "string", "minLength": 1},
              "armature_object": {"type": "string", "minLength": 1},
              "model_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "bone_mapping": {"type": "object", "additionalProperties": {"type": ["string", "null"]}},
              "morph_mapping": {"type": "object", "additionalProperties": {"type": ["string", "null"]}},
              "required_bone_count": {"type": "integer", "minimum": 1},
              "resolved_bone_count": {"type": "integer", "minimum": 0},
              "bone_coverage": {"type": "number", "minimum": 0, "maximum": 1},
              "required_mouth_morph_count": {"type": "integer", "minimum": 1},
              "resolved_mouth_morph_count": {"type": "integer", "minimum": 0},
              "mouth_morph_coverage": {"type": "number", "minimum": 0, "maximum": 1},
              "blink_morph_resolved": {"type": "boolean"},
              "texture_count": {"type": "integer", "minimum": 0},
              "missing_texture_count": {"type": "integer", "minimum": 0},
              "license_name": {"type": "string"},
              "license_warning": {"type": "boolean"},
              "warnings": {"type": "array", "items": {"type": "string"}},
              "ready": {"type": "boolean"}
            },
            "additionalProperties": false
          }
        },
        "configured_count": {"type": "integer", "minimum": 0},
        "ready_count": {"type": "integer", "minimum": 0},
        "missing_texture_count": {"type": "integer", "minimum": 0},
        "warning_count": {"type": "integer", "minimum": 0},
        "license_warning_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "shots": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["scene_id", "shot_id", "start_frame", "end_frame", "shot_type", "movement", "target"],
        "properties": {
          "scene_id": {"type": "string"}, "shot_id": {"type": "string"},
          "start_frame": {"type": "integer", "minimum": 1},
          "end_frame": {"type": "integer", "minimum": 1},
          "shot_type": {"type": "string"}, "movement": {"type": "string"},
          "target": {"type": ["string", "null"]}
        }, "additionalProperties": false
      }
    },
    "dialogue": {
      "type": "array",
      "items": {
        "type": "object", "required": ["line_id", "shot_id", "character", "audio_path", "start_frame", "end_frame", "start_seconds", "duration_seconds", "mouth_cues"],
        "properties": {
          "line_id": {"type": "string"}, "shot_id": {"type": "string"},
          "character": {"type": "string"}, "audio_path": {"type": "string"},
          "start_frame": {"type": "integer", "minimum": 1},
          "end_frame": {"type": "integer", "minimum": 1},
          "start_seconds": {"type": "number", "minimum": 0},
          "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
          "mouth_cues": {"type": "array", "items": {"type": "object"}}
        }, "additionalProperties": false
      }
    },
    "summary": {
      "type": "object", "required": ["shot_count", "dialogue_count", "mouth_cue_count", "performance_clip_count", "gesture_count", "dialogue_beat_count", "gaze_target_count", "blink_event_count", "listener_reaction_count", "performance_conflict_count", "blocking_shot_count", "character_placement_count", "body_facing_count", "camera_motion_count", "framing_risk_count", "camera_collision_risk_count", "continuity_violation_count", "blocking_conflict_count", "production_character_count", "character_asset_ready_count", "character_texture_missing_count", "character_asset_warning_count", "character_license_warning_count"],
      "properties": {
        "shot_count": {"type": "integer", "minimum": 1},
        "dialogue_count": {"type": "integer", "minimum": 0},
        "mouth_cue_count": {"type": "integer", "minimum": 0},
        "performance_clip_count": {"type": "integer", "minimum": 0},
        "gesture_count": {"type": "integer", "minimum": 0},
        "dialogue_beat_count": {"type": "integer", "minimum": 0},
        "gaze_target_count": {"type": "integer", "minimum": 0},
        "blink_event_count": {"type": "integer", "minimum": 0},
        "listener_reaction_count": {"type": "integer", "minimum": 0},
        "performance_conflict_count": {"type": "integer", "minimum": 0},
        "blocking_shot_count": {"type": "integer", "minimum": 0},
        "character_placement_count": {"type": "integer", "minimum": 0},
        "body_facing_count": {"type": "integer", "minimum": 0},
        "camera_motion_count": {"type": "integer", "minimum": 0},
        "framing_risk_count": {"type": "integer", "minimum": 0},
        "camera_collision_risk_count": {"type": "integer", "minimum": 0},
        "continuity_violation_count": {"type": "integer", "minimum": 0},
        "blocking_conflict_count": {"type": "integer", "minimum": 0},
        "production_character_count": {"type": "integer", "minimum": 0},
        "character_asset_ready_count": {"type": "integer", "minimum": 0},
        "character_texture_missing_count": {"type": "integer", "minimum": 0},
        "character_asset_warning_count": {"type": "integer", "minimum": 0},
        "character_license_warning_count": {"type": "integer", "minimum": 0}
      }, "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "vector3": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"type": "number", "minimum": -1000, "maximum": 1000}
    }
  }
}
